# =============================================================================
# AuralisAPI — Root Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env     (Linux/macOS/Git Bash/WSL)
#   copy .env.example .env   (Windows cmd)
#
# .env is gitignored — never commit real secrets.
# docker-compose automatically loads .env from the project root.
#
# Variables marked [REQUIRED for production] must be set before deploying.
# Variables marked [optional] have safe defaults for development.
# =============================================================================

# --- LLM (AI incident report generation) ---
# PRIMARY: Anthropic Claude claude-haiku-4-5 — fast, recommended
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# FALLBACK: Groq (used only if ANTHROPIC_API_KEY is not set)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub (GitOps PR generation — used by enforce_node) ---
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=your-org/auralisapi
GITHUB_BRANCH=main

# --- Security [REQUIRED for production] ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-a-long-random-string-in-production

# Admin credentials for the intelligence dashboard login
# These validate against POST /auth/token — change before deploying
ADMIN_EMAIL=admin@auralisapi.dev
ADMIN_PASSWORD=auralis2025

# JWT token lifetime in hours (default: 24)
JWT_EXPIRE_HOURS=24

# Allowed CORS origins for the brain API (comma-separated)
# In production set this to your UI domain: https://yourapp.com
# In development: left empty = allows localhost:3000 automatically
ALLOWED_ORIGINS=

# --- Infrastructure passwords [REQUIRED for production] ---
# Redis: leave empty for no-auth (development only)
# Set to a strong password in production
REDIS_PASSWORD=

# PostgreSQL credentials
POSTGRES_USER=auralis
POSTGRES_PASSWORD=auralis
POSTGRES_DB=auralis

# --- App settings ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Sensor mode ---
# mock  = replay fixtures (default, works on Windows)
# live  = real eBPF kernel injection (Linux host only, kernel >= 5.8)
SENSOR_MODE=mock

# Inter-event delay during fixture replay (milliseconds, default 100)
# Lower = faster demo; raise to 500+ for slow/realistic replay
REPLAY_DELAY_MS=100

# --- Consumer tuning [optional] ---
# Deduplication window — skip events for a path seen within this many seconds
DEDUP_WINDOW_SECS=60
# Start position in the Redis stream: '$' = new messages only (default)
# Set to '0' for recovery to replay from beginning
CONSUMER_START_ID=$

# --- API classification [optional] ---
# Comma-separated prefixes considered "current" API versions
# Paths NOT starting with these (and not in spec) are classified as shadows
CURRENT_API_PREFIXES=/api/v3/

# --- Intelligence UI public URLs [optional — Docker Compose only] ---
# NEXT_PUBLIC_* vars are baked into the browser bundle at `next build` time.
#
# Docker Compose mode (default): leave all three empty.
#   Browser fetches use relative /brain/*, /drift/*, /api/* paths which the
#   Next.js server proxies to internal services via next.config.ts rewrites().
#
# Standalone / CDN mode: set to the public-facing URLs of each service.
#   The UI will call these origins directly from the browser instead of rewrites.
NEXT_PUBLIC_BRAIN_URL=
NEXT_PUBLIC_SENSOR_URL=
NEXT_PUBLIC_API_URL=
