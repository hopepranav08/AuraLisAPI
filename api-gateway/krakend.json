        {
            "endpoint": "/api/v1/legacy-payments",
            "method": "GET",
            "output_encoding": "json",
            "backend": [{ "url_pattern": "/gone", "host": ["http://remediation-brain:8000"], "encoding": "json" }],
            "extra_config": {
                "proxy/static": {
                    "data": {
                        "error":   "Gone",
                        "code":    410,
                        "message": "The /api/v1/legacy-payments endpoint has been decommissioned. Migrate to /api/v3/payments. See OWASP API9:2023.",
                        "sunset":  "2025-01-01T00:00:00Z"
                    },
                    "strategy": "always",
                    "status_code": 410
                }
            }
