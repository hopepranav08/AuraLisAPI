        {
            "endpoint": "/api/v1/{endpoint}",
            "method": "GET",
            "output_encoding": "json",
            "backend": [{ "url_pattern": "/gone", "host": ["http://remediation-brain:8000"], "encoding": "json" }],
            "extra_config": {
                "proxy/static": {
